  "interactions": [
    {
      "verb": "inspect",
      "object": "clock",
      "effects": [{ "type": "display_message", "text": "A dusty wall clock.\nThe hands are stopped at 03:15." }]
    },
    {
      "verb": "inspect",
      "object": "desk",
      "conditions": [{ "type": "flag_equals", "flag": "drawer_open", "value": false }],
      "effects": [{ "type": "display_message", "text": "The wood is warped by damp.\nOne drawer has a four-digit combination lock." }]
    },
    {
      "verb": "inspect",
      "object": "desk",
      "effects": [{ "type": "display_message", "text": "The wood is warped by damp.\nIts drawer hangs open, empty." }]
    },
    {
      "verb": "inspect",
      "object": "drawer",
      "conditions": [{ "type": "flag_equals", "flag": "drawer_open", "value": false }],
      "effects": [{ "type": "display_message", "text": "Four rusty dials hold the drawer shut." }]
    },
    {
      "verb": "inspect",
      "object": "drawer",
      "effects": [{ "type": "display_message", "text": "The drawer is open and empty." }]
    },
    {
      "verb": "open",
      "object": "drawer",
      "conditions": [{ "type": "flag_equals", "flag": "drawer_open", "value": false }],
      "effects": [{ "type": "display_message", "text": "It's locked. The dials need a four-digit code." }]
    },
    {
      "verb": "use",
      "item": "0315",
      "object": "drawer",
      "conditions": [{ "type": "flag_equals", "flag": "drawer_open", "value": false }],
      "effects": [
        { "type": "set_flag", "flag": "drawer_open", "value": true },
        { "type": "display_message", "text": "The dials click into place. The drawer opens.\nYou found a brass key!" },
        { "type": "add_item", "item": "brass_key" }
      ]
    },
    {
      "verb": "inspect",
      "object": "bookshelf",
      "effects": [{ "type": "display_message", "text": "Swollen, rotting books.\nTheir titles have bled into illegibility." }]
    },
    {
      "verb": "inspect",
      "object": "door",
      "effects": [{ "type": "display_message", "text": "A heavy wooden door with a tarnished brass lock." }]
    },
    {
      "verb": "open",
      "object": "door",
      "conditions": [{ "type": "flag_equals", "flag": "door_unlocked", "value": false }],
      "effects": [{ "type": "display_message", "text": "The door is locked." }]
    },
    {
      "verb": "use",
      "item": "brass_key",
      "object": "door",
      "conditions": [{ "type": "has_item", "item": "brass_key" }],
      "effects": [
        { "type": "set_flag", "flag": "door_unlocked", "value": true },
        { "type": "display_message", "text": "The key turns with a groan. The door unlocks.\nStone steps lead down into the dark." },
        { "type": "change_room", "room": "cellar" }
      ]
    }
  ]
}
