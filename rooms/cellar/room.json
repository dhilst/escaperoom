      "description": "A rusted workbench stands beside a fuse box.\nShelves of murky jars line the wall. Water drips somewhere."
    },
    "C": {
      "image": "camera_c.png",
      "description": "Crates sit in black, ankle-deep water.\nA steel door with a keypad is set in the wall."
    }
  },
  "objects": {
    "workbench": {
      "name": "workbench",
      "aliases": ["bench", "work bench", "tools"],
      "cameras": ["A"]
    },
